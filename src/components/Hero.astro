---
/**
 * @category Hero
 * @name Hero
 */
---
<section
  class='grid w-full h-auto py-12 px-2 items-center gap-4 grid-cols-1 sm:py-16 sm:px-4 sm:gap-8 md:px-8 md:py-20 md:grid-cols-12 lg:px-16 lg:py-24 lg:gap-8 bg-[url(/assets/images/content/hero-bg.webp)] bg-cover bg-center'
>
  <div
    class='col-span-full flex flex-col justify-center items-start text-left gap-4 sm:gap-5 md:col-span-6 md:gap-4'
  >
    <div
      class='flex items-center justify-center px-3 py-1 bg-sky-100 rounded-full sm:px-3.5 sm:bg-sky-100 sm:rounded-sm'
    >
      <span
        class='text-sky-800 text-xs font-semibold sm:text-sm'>Label</span
      >
    </div>
    <h1
      class="text-stone-100 font-sans text-3xl font-bold leading-tight tracking-tight sm:text-4xl sm:leading-tight md:text-5xl md:leading-none md:tracking-[-0.02em] lg:text-7xl lg:leading-none lg:tracking-[-1.44px] xl:text-8xl 2xl:text-8xl"
    >
      Build your next&nbsp;Astro masterpiece
    </h1>
    <p
      class='text-stone-300 font-sans text-sm font-normal leading-relaxed sm:text-base sm:leading-6 md:text-lg md:leading-7 lg:text-base lg:leading-6'
    >
      Create your next website using 123 free astro components stylized with
      TailwindCSS. No demo versions, no paywall, just an honest free template
      for Astro community
    </p>
    <div class='flex flex-col gap-3 mt-4 sm:flex-row sm:gap-2 sm:mt-2'>
      <button
        class='whitespace-nowrap flex justify-center items-center px-4 py-2.5 bg-yellow-400 text-sm text-stone-800 font-semibold rounded-md hover:bg-yellow-500 transition-colors duration-100 sm:px-5'
      >
        Primary Action
      </button>
      <button
        class='whitespace-nowrap flex justify-center items-center px-4 py-2.5 bg-stone-200 text-sm text-stone-800 font-semibold rounded-md hover:bg-stone-300 transition-colors duration-100 sm:px-5'
      >
        Secondary Action
      </button>
    </div>
  </div>
  <div
    class='hidden md:flex md:col-span-6 items-center justify-center'
  >
    <!-- <img src='/assets/images/content/hero-bg.webp' alt='Hero image' class='w-full h-auto object-cover' /> -->
  </div>
</section>
